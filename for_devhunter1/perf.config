# ====================================================================
# PERFORMANCE.CONFIG: CPU, Memory, I/O, TCP, Scheduling, 
#                     Power & Debug Stripping
# ====================================================================

# --- CPU Timers & Governors ---
# CONFIG_HZ_300=y
# CONFIG_HZ=300
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y

# --- Multi-Core Scheduling (Activates CPU Scan Order Patches) ---
CONFIG_SCHED_MC=y

# --- Compiler & Inlining Optimizations ---
CONFIG_FRAME_WARN=0
CONFIG_OPTIMIZE_INLINING=y

# --- Memory Management, MGLRU & ZRAM ---
CONFIG_SWAP=y
CONFIG_BLK_DEV_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_WRITEBACK=y
# CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# --- I/O Scheduler & Filesystem Optimizations ---
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_DEFAULT_DEADLINE=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_COMPRESSION=y

# --- Network Queueing & TCP Congestion Control ---
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_PIE=y
CONFIG_NET_SCH_FQ_PIE=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
CONFIG_DEFAULT_TCP_CONG="bbr3"
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_CUBIC=y

# --- Android Power & Sleep (Activates Wakelock & S2Idle Patches) ---
CONFIG_PM_SLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=0

# --- Strip Debug Overhead ---
CONFIG_UBSAN=n
CONFIG_PAGE_OWNER=n
CONFIG_RCU_TRACE=n
