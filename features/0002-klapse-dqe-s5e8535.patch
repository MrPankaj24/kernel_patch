diff --git a/drivers/gpu/drm/samsung/dpu/Kconfig b/drivers/gpu/drm/samsung/dpu/Kconfig
index eadbf490edf9..693e6ed47bad 100755
--- a/drivers/gpu/drm/samsung/dpu/Kconfig
+++ b/drivers/gpu/drm/samsung/dpu/Kconfig
@@ -145,6 +145,18 @@ config KCAL_CTRL
 	  brightness and contrast are composed onto the panel's own
 	  gamma matrix at program time.
 
+config KLAPSE_CTRL
+	bool "Support KLapse time-based color shift (requires KCAL)"
+	depends on KCAL_CTRL
+	default n
+	help
+	  KLapse automatically interpolates RGB gains between a daytime
+	  and a nighttime profile based on the clock, feeding the KCAL
+	  DQE pipeline every minute.
+	  See /sys/kernel/klapse/ (enabled, daytime_rgb, nighttime_rgb,
+	  mode_hour_start, mode_hour_end, mode, brightness_factor,
+	  target_rgb).
+
 config EXYNOS_FREQ_HOP
     tristate "Support DPHY PLL Frequency Hopping"
 	depends on DRM_SAMSUNG_DECON
